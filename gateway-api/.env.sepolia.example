# Base Sepolia shape for phases 1 to 4 of docs/critical-accounts/05-test-plan.md.
# Copy to .env on the laptop or to /srv/xkoin/.env on the VPS, fill the blanks,
# never commit the copy. Addresses come from contracts/deployments/84532.json.

# --- chain -------------------------------------------------------------
XKOIN_RPC_URL=https://sepolia.base.org
XKOIN_CHAIN_ID=84532
XKOIN_DRY_RUN=false
XKOIN_TOKEN_ADDRESS=
XKOIN_TREASURY_ADDRESS=
XKOIN_ESCROW_ADDRESS=
XKOIN_BRIDGE_PRIVATE_KEY=
XKOIN_BRIDGE_ADDRESS=
XKOIN_BENEFICIARY_ADDRESS=

# --- Jenga UAT ----------------------------------------------------------
XKOIN_JENGA_BASE_URL=https://uat.finserve.africa
XKOIN_JENGA_API_KEY=
XKOIN_JENGA_MERCHANT_CODE=
XKOIN_JENGA_CONSUMER_SECRET=
XKOIN_JENGA_PRIVATE_KEY_PATH=/run/secrets/jenga_private.pem
XKOIN_CALLBACK_BASE_URL=https://xkoin.thuku.dev

# --- payout worker ------------------------------------------------------
XKOIN_PAYOUT_MSISDN=
XKOIN_PAYOUT_MSISDN_SIGNATURE=
XKOIN_PAYOUT_LEDGER_PATH=/data/payout_ledger.sqlite3

# --- kiosk vouchers -----------------------------------------------------
XKOIN_KIOSK_ROOT_KEY_HEX=

# --- Daraja (unused until the second bridge) ---------------------------
XKOIN_DARAJA_CONSUMER_KEY=
XKOIN_DARAJA_CONSUMER_SECRET=
XKOIN_DARAJA_PASSKEY=
XKOIN_DARAJA_B2C_SHORTCODE=
XKOIN_DARAJA_INITIATOR_NAME=
XKOIN_DARAJA_SECURITY_CREDENTIAL=
