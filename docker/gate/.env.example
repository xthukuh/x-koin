# Pass-wall settings for docker/compose.site.yml. Copy the ones you need into
# the .env file that sits next to the compose file (on the VPS that is
# /docker/xkoin-site/.env, which scripts/deploy-site.sh writes).
#
# Full notes: docs/ops/critical-accounts/07-pass-wall.md

# The hostname Traefik routes to the site.
XKOIN_SITE_HOST=xkoin.thuku.dev

# The password everyone gets unless they were given a named one.
XKOIN_GATE_PASSWORD=xkoin#2030

# Optional named passwords, comma separated name:password pairs. Deleting one
# and restarting the gate revokes that name's live cookies and nobody else's.
# A name is [A-Za-z0-9_-]{1,64}. A password may contain a colon, not a comma.
# XKOIN_GATE_NAMED=legal:changeme1,investor-a:changeme2

# The HMAC key that signs cookies. 32 random bytes as hex: scripts/gate-secret.sh
# prints one. Changing it logs everyone out. Leaving it unset makes the gate
# generate a throwaway key at start and warn, so cookies die on every restart.
XKOIN_GATE_SECRET=

# How long a cookie lasts. Default 72.
XKOIN_GATE_TTL_HOURS=72

# Secure flag on the cookie. true everywhere TLS terminates in front of the
# site, which is the VPS. Set false only for the plain http://127.0.0.1:8090
# local test, otherwise the browser drops the cookie.
XKOIN_GATE_SECURE=true

# Read the client address from the first hop of X-Forwarded-For. true behind
# Traefik and behind the site's own nginx, which is every deployment here.
XKOIN_GATE_TRUST_PROXY=true
